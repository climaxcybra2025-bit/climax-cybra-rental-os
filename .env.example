SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
DATABASE_URL=postgres://rental:rental@db:5432/rental_os
# Email for urgent tickets (console backend prints to the log when unset)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Encrypts integration secrets (Hostaway API key, Telegram bot token, n8n signing secret) in the database.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy safe: without it saved secrets cannot be read and must be re-entered.
FIELD_ENCRYPTION_KEY=
# Background scheduler: how often to pull bookings from Hostaway, and the local hour daily jobs start
SCHEDULER_SYNC_MINUTES=15
DAILY_JOBS_HOUR=6
